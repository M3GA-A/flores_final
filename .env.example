# Copia este archivo como .env y completa solo los valores necesarios.
# Genera una clave con: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# La aplicación muestra reseñas de demostración si estos valores quedan vacíos.
GOOGLE_API_KEY=
GOOGLE_PLACE_ID=

# Activa debug únicamente durante el desarrollo local.
FLASK_DEBUG=false
SESSION_COOKIE_SECURE=false

# En producción conviene utilizar Redis en lugar de memory://.
RATELIMIT_STORAGE_URI=memory://
